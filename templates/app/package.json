{
  "name": "catba-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ssr": "vite build --ssr .catba/generated/ssr-entry.js --outDir .catba/generated/ssr",
    "build:client": "vite build --outDir .catba/generated/client",
    "build": "npm run build:ssr && npm run build:client"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
